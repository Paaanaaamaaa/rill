(def sq (clause (x:arg) (* x:arg x:arg)))
(def fact (clause (0) 1) (clause (n:arg) (* n:arg (call fact:fn (- n:arg 1)))))
(def two (clause (a:arg b:arg) (+ a:arg b:arg)))
(<~ avg:fn (train +/ % #))
(<~ total:val 4)
(<~! count:mut 0)
(~! count:mut (+ count:mut 1))
(>>! (call sq:fn 3))
(>>! (call fact:fn 20))
(>>! (call two:fn 1 2))
(>>! (call avg:fn (strand 1 2 3 4)))
(>>! (strand total:val 5 6))
(>>! (strand 1 2 3))
(>>! (call sq:fn (strand 1 2)))
